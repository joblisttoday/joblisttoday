{
	"name": "joblist",
	"url": "https://joblist.today",
	"source": "https://github.com/joblisttoday/joblisttoday",
	"collections": {
		"company": "today.joblist.company",
		"job": "today.joblist.job"
	},
	"lexicons": {
		"dir": "lexicons",
		"did": "did:plc:jqaucxlucukeif3bltpuc7zx",
		"permissionSet": "today.joblist.authFull"
	},
	"locales": [
		"en",
		"fr",
		"de",
		"es"
	],
	"defaultLocale": "en",
	"embed": {
		"page": "/embed",
		"scripts": "/embed/",
		"shown": 20
	},
	"analytics": {
		"script": "/vendor/umami.js",
		"hostUrl": "https://gateway.umami.is",
		"websiteId": "479fa5c4-e9c9-4d8d-85c6-9a88c886dd24",
		"domains": "joblist.today"
	},
	"services": {
		"appview": "https://public.api.bsky.app",
		"plc": "https://plc.directory",
		"handleResolver": "https://public.api.bsky.app",
		"dns": "https://cloudflare-dns.com/dns-query",
		"relay": "https://relay1.us-east.bsky.network",
		"placeSearch": "https://photon.komoot.io/api/",
		"placeAt": "https://photon.komoot.io/reverse"
	},
	"links": {
		"signup": "https://bsky.app",
		"bluesky": "https://bsky.app/profile/{did}"
	},
	"jobPost": {
		"days": 30,
		"maxDays": 120,
		"dayChoices": [
			7,
			14,
			30,
			60,
			120
		],
		"titleMax": 200,
		"descriptionMax": 10000,
		"page": "/job/{did}/{rkey}",
		"remote": [
			"onsite",
			"hybrid",
			"remote"
		],
		"employment": [
			"full-time",
			"part-time",
			"contract",
			"internship",
			"volunteer"
		]
	},
	"limits": {
		"pagesPerRepo": 100
	},
	"shareImage": {
		"path": "/og.png",
		"width": 1200,
		"height": 630
	},
	"map": {
		"style": "https://tiles.openfreemap.org/styles/positron",
		"styleDark": "https://tiles.openfreemap.org/styles/dark",
		"projection": "globe",
		"center": [
			10,
			30
		],
		"zoom": 1,
		"maxZoom": 11,
		"pickZoom": 15,
		"padding": 48,
		"pointRadius": 6,
		"pointStroke": 2,
		"clusterRadius": 40,
		"clusterMaxZoom": 11,
		"popupMax": 8,
		"font": [
			"Noto Sans Regular"
		],
		"finePointer": "(hover: hover) and (pointer: fine)"
	},
	"placeSearch": {
		"limit": 8,
		"minLength": 2,
		"delayMs": 250,
		"languages": [
			"en",
			"fr",
			"de"
		],
		"layers": [
			"house",
			"street",
			"other",
			"city",
			"locality",
			"district",
			"county",
			"state",
			"country"
		]
	},
	"search": {
		"minLength": 2,
		"shown": 30,
		"organizations": 200
	},
	"companyForm": {
		"locationsMax": 50,
		"linksMax": 20,
		"sections": [
			"about",
			"kind",
			"tags",
			"places",
			"links"
		]
	}
}
